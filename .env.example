# Application Settings
APP_NAME=LedgerLeaf
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Storage & Database Configuration
DATA_DIR=data
DATABASE_URL=sqlite:///./data/ledgerleaf.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=15

# Security & CORS Settings (JSON-encoded list)
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500","null"]

# Local LM Studio / OpenAI-compatible local AI server
AI_PROVIDER=lm_studio
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=llama-3.2-1b-instruct
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1
